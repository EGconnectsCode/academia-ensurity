{
  "version": 2,
  "name": "academia-ensurity",
  "rewrites": [
    { "source": "/",                  "destination": "/academia-ensurity.html" },
    { "source": "/allstate",          "destination": "/modules/allstate/allstate-academy.html" },
    { "source": "/american-amicable", "destination": "/modules/american-amicable/american-amicable.html" },
    { "source": "/cica",              "destination": "/modules/cica/cica-citizens-v2.html" },
    { "source": "/admin",             "destination": "/admin/admin-panel.html" },
    { "source": "/corebr",           "destination": "/modules/corebr/COREBR_1.html" },
    { "source": "/gtl",              "destination": "/modules/gtl/gtl-dashboard.html" },
    { "source": "/liberty-bankers",  "destination": "/modules/liberty-bankers/liberty-bankers.html" },
    { "source": "/moo",              "destination": "/modules/moo/moo-dashboard.html" },
    { "source": "/reset-password",   "destination": "/reset-password.html" },
    { "source": "/texas-life-health", "destination": "/modules/texas-life-health/texas-life-health.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Content-Security-Policy", "value": "frame-ancestors 'self' https://*.bitrix24.com https://*.bitrix24.eu" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy",        "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/shared/supabase-config.js",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=300" }
      ]
    }
  ]
}
